# `bunx convex dev --once` creates or selects your own development deployment
# and writes its actual URLs to the ignored .env.local file.
CONVEX_DEPLOYMENT=dev:your-deployment
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Generate a secret and use the same value in your Convex deployment.
AUTH_PROXY_SECRET=replace-with-a-random-secret
